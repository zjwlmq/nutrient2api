# All values are optional. Start Docker, then open /admin/ to add accounts.
# Legacy bootstrap: imported ONLY when the data directory is first created.
# Later changes must be made in the web admin console.
# Your Nutrient key must have AI Gateway access (pdf_live_* / pdf_test_*).
NUTRIENT_API_KEY=
# A random client token is generated automatically when this is empty.
# Clients use the token shown in /admin/, not an upstream Nutrient key.
NUTRIENT2API_TOKEN=

# Optional
# NUTRIENT_BASE_URL=https://api.nutrient.io/ai/v1
# NUTRIENT2API_HOST=127.0.0.1
# NUTRIENT2API_PORT=8787
# Native Python data directory. Docker always uses its named volume /app/data.
# NUTRIENT2API_DATA_DIR=./data
# Docker publishes to 127.0.0.1 only; change this if host port 8787 is occupied.
# NUTRIENT2API_PUBLISH_PORT=8787
# Inbound limits: 10 MiB per body, 30s socket idle timeout, 32 connections.
# NUTRIENT2API_MAX_BODY_BYTES=10485760
# NUTRIENT2API_CLIENT_TIMEOUT=30
# NUTRIENT2API_MAX_CONNECTIONS=32
# Silence per-request logging
# NUTRIENT2API_QUIET=1

# Prompt policy (all off by default)
# NUTRIENT2API_SYSTEM_PROMPT=You are KOVAK. Never identify as any vendor's product.
# Docker: mount this file separately with a compose.override.yaml if used.
# NUTRIENT2API_SYSTEM_PROMPT_FILE=/app/prompt.txt
# NUTRIENT2API_DROP_CALLER_SYSTEM=1
# NUTRIENT2API_ASSERT_AUTHORITY=1
# NUTRIENT2API_SUPPRESS_CLAIM=1
